{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legendteddy/scan/schema/observed-evidence-receipt-1.schema.json",
  "title": "Scan observed evidence receipt v1",
  "type": "object",
  "required": ["scan_observed_receipt_version", "target", "executor", "authorization", "execution", "coverage", "observations"],
  "properties": {
    "scan_observed_receipt_version": {"const": "1"},
    "target": {"type": "object", "required": ["snapshot_digest"], "properties": {"snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "executor": {"type": "object", "required": ["kind", "name", "version"], "properties": {"kind": {"const": "external-tool"}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 256}}, "additionalProperties": false},
    "authorization": {"type": "object", "required": ["basis", "scope", "reference"], "properties": {"basis": {"type": "string", "minLength": 1, "maxLength": 256}, "scope": {"type": "string", "minLength": 1, "maxLength": 20000}, "reference": {"type": "string", "minLength": 1, "maxLength": 1024}}, "additionalProperties": false},
    "execution": {"type": "object", "required": ["execution_id", "started_at", "completed_at", "environment", "target_executed", "network_used"], "properties": {"execution_id": {"type": "string", "minLength": 1, "maxLength": 512}, "started_at": {"type": "string", "minLength": 1, "maxLength": 128}, "completed_at": {"type": "string", "minLength": 1, "maxLength": 128}, "environment": {"type": "string", "minLength": 1, "maxLength": 1024}, "target_executed": {"type": "boolean"}, "network_used": {"type": "boolean"}}, "additionalProperties": false},
    "coverage": {"type": "object", "required": ["scope", "limitations", "whole_project_complete"], "properties": {"scope": {"type": "string", "minLength": 1, "maxLength": 20000}, "limitations": {"type": "string", "minLength": 1, "maxLength": 20000}, "whole_project_complete": {"const": false}}, "additionalProperties": false},
    "observations": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "finding": {"type": "object", "required": ["title", "impact", "severity", "confidence", "uncertainty", "recommendation", "safe_verification"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 20000}, "impact": {"type": "string", "minLength": 1, "maxLength": 20000}, "severity": {"enum": ["critical", "high", "medium", "low", "informational"]}, "confidence": {"type": "string", "minLength": 1, "maxLength": 128}, "uncertainty": {"type": "string", "minLength": 1, "maxLength": 20000}, "recommendation": {"type": "string", "minLength": 1, "maxLength": 20000}, "safe_verification": {"type": "string", "minLength": 1, "maxLength": 20000}}, "additionalProperties": false},
    "control": {"type": "object", "required": ["description", "limitations"], "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 20000}, "limitations": {"type": "string", "minLength": 1, "maxLength": 20000}}, "additionalProperties": false},
    "unknown": {"type": "object", "required": ["question", "reason", "impact", "next_safe_step"], "properties": {"question": {"type": "string", "minLength": 1, "maxLength": 20000}, "reason": {"type": "string", "minLength": 1, "maxLength": 20000}, "impact": {"type": "string", "minLength": 1, "maxLength": 20000}, "next_safe_step": {"type": "string", "minLength": 1, "maxLength": 20000}}, "additionalProperties": false},
    "observation": {"type": "object", "required": ["external_id", "outcome", "artifact_locator", "artifact_content_identity", "claim", "result", "method", "limitations"], "properties": {"external_id": {"type": "string", "minLength": 1, "maxLength": 512}, "outcome": {"enum": ["pass", "fail", "unknown"]}, "artifact_locator": {"type": "string", "minLength": 1, "maxLength": 4096}, "artifact_content_identity": {"type": "string", "minLength": 1, "maxLength": 512}, "locator": {"type": "string", "minLength": 1, "maxLength": 4096}, "claim": {"type": "string", "minLength": 1, "maxLength": 20000}, "result": {"type": "string", "minLength": 1, "maxLength": 20000}, "method": {"type": "string", "minLength": 1, "maxLength": 20000}, "limitations": {"type": "string", "minLength": 1, "maxLength": 20000}, "observed_at": {"type": "string", "minLength": 1, "maxLength": 128}, "finding": {"$ref": "#/$defs/finding"}, "control": {"$ref": "#/$defs/control"}, "unknown": {"$ref": "#/$defs/unknown"}}, "allOf": [{"if": {"properties": {"outcome": {"const": "fail"}}}, "then": {"required": ["finding"]}}, {"if": {"properties": {"outcome": {"const": "pass"}}}, "then": {"required": ["control"]}}, {"if": {"properties": {"outcome": {"const": "unknown"}}}, "then": {"required": ["unknown"]}}], "additionalProperties": false}
  },
  "additionalProperties": false,
  "$comment": "Data-only runtime/test observation receipt. Scan imports it without executing the target and does not independently verify the authorization attestation identity."
}
