{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legendteddy/scan/scanbench/review-receipt-2.0-alpha1.schema.json",
  "title": "ScanBench 2.0 independent review receipt",
  "type": "object",
  "required": [
    "scanbench2_version",
    "review_receipt_version",
    "project_id",
    "fixture_digest",
    "reviewer",
    "reviewer_role",
    "independent_of_fixture_author",
    "decision",
    "reviewed_condition_ids"
  ],
  "properties": {
    "scanbench2_version": {"const": "2.0-alpha1"},
    "review_receipt_version": {"const": "2.0-alpha1"},
    "project_id": {"type": "string", "minLength": 1},
    "fixture_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "independent_of_fixture_author": {"type": "boolean"},
    "decision": {"enum": ["approved", "changes_requested"]},
    "reviewed_condition_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
